{
  "manifest_version": 3,
  "name": "Taobao Currency Converter",
  "version": "2.0.0",
  "description": "Convert Taobao CNY prices to USD, EUR, VND, and 40+ other currencies in real time.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "*://*.taobao.com/*",
    "*://taobao.com/*",
    "https://open.er-api.com/*"
  ],
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Taobao Currency Converter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "32": "public/icons/icon-32.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.taobao.com/*", "*://taobao.com/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
